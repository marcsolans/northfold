# =============================================================================
# Messer — environment variables
# Copy to `.env` (git-ignored) and fill in. Every variable is optional for local
# development: when a key is missing, Messer uses a mock/sandbox adapter and the
# feature is listed under "Pending keys" in PROGRESS.md.
# =============================================================================

# --- Core -------------------------------------------------------------------
# local | staging | production
MESSER_ENV=local
# Public URL of the web app (Next.js). Used for links in emails, OAuth callbacks, widget.
MESSER_WEB_URL=http://localhost:3000
# Public URL of the platform API (FastAPI). The web app proxies /api/* to it.
MESSER_API_URL=http://localhost:8000
# Internal URL of the runtime (data plane). Control plane -> data plane calls.
MESSER_RUNTIME_URL=http://localhost:8100
# Internal URL of the voice gateway.
MESSER_VOICE_URL=http://localhost:8300
# 32-byte urlsafe base64 master key used to encrypt secrets/credentials at rest (Fernet).
# Generate with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MESSER_SECRETS_KEY=
# HMAC secret for session JWTs in local auth mode and for signed single-use links.
MESSER_JWT_SECRET=
# Shared token that authenticates control plane <-> data plane calls (mTLS-ready, see docs/byoc.md).
MESSER_SERVICE_TOKEN=
# Optional mTLS material for control plane <-> data plane (paths to PEM files).
MESSER_MTLS_CA=
MESSER_MTLS_CERT=
MESSER_MTLS_KEY=
# Where project git repositories live (one repo per project).
MESSER_PROJECTS_DIR=./.data/projects
# Local file storage root used when Supabase Storage is not configured.
MESSER_STORAGE_DIR=./.data/storage
# First superadmin created by `make bootstrap`.
MESSER_SUPERADMIN_EMAIL=admin@messer.local
MESSER_SUPERADMIN_PASSWORD=
# Margin applied on top of raw model cost when converting to credits (0.3 = +30%).
MESSER_CREDIT_MARGIN=0.3
# USD value of one credit.
MESSER_CREDIT_USD=0.01

# --- Database (Supabase Postgres, EU region) --------------------------------
# Owner connection used for migrations (Alembic) and bootstrap.
DATABASE_URL=postgresql+psycopg://messer:messer@localhost:5432/messer
# Application connection (role WITHOUT BYPASSRLS). Every request runs under RLS.
DATABASE_APP_URL=postgresql+psycopg://messer_app:messer_app@localhost:5432/messer
# Read-only connection for agent/console SQL (role messer_readonly).
DATABASE_READONLY_URL=postgresql+psycopg://messer_readonly:messer_readonly@localhost:5432/messer

# --- Supabase (Auth + Storage, EU region) -----------------------------------
# When empty, Messer uses its built-in local auth (email+password, JWT) and local file storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret of the Supabase project (Settings -> API) to verify access tokens.
SUPABASE_JWT_SECRET=

# --- Redis (queue, cache, real time; EU region) ------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Models -----------------------------------------------------------------
# Direct Anthropic API. Without it the model gateway serves a deterministic demo model.
ANTHROPIC_API_KEY=
# Claude on AWS Bedrock in an EU region (required for eu_strict organizations).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# Optional: other providers accepted by the router (provider/model strings).
OPENAI_API_KEY=
# Embeddings: local (fastembed, default) | voyage | bedrock
MESSER_EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=

# --- Stripe (test-mode keys are fine) ----------------------------------------
# When empty, billing runs in simulated test mode (no network calls).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Email (transactional provider with an EU region) -----------------------
# console | smtp | postmark | resend
MESSER_EMAIL_PROVIDER=smtp
MESSER_EMAIL_FROM="Messer <no-reply@messer.local>"
# SMTP (Mailpit locally: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
# Postmark (EU) / Resend (EU) tokens if you use them instead of SMTP.
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
# Domain for inbound email addresses (workflow triggers, email channel).
MESSER_INBOUND_EMAIL_DOMAIN=in.messer.local
# Shared secret the inbound email provider uses to sign webhook calls.
MESSER_INBOUND_EMAIL_SECRET=

# --- Observability ----------------------------------------------------------
# Sentry (EU region: https://<key>@<org>.ingest.de.sentry.io/<project>)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# PostHog (EU instance)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# OTLP endpoint for traces (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- OAuth apps (connectors and social login) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# GitHub App / OAuth for project sync
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- Channels and voice -----------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELNYX_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# STT / TTS providers (EU regions). Without keys the voice module uses its local defaults.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Deployment --------------------------------------------------------------
# Root domain for published interfaces and custom domains (e.g. messer.eu)
MESSER_ROOT_DOMAIN=localhost
# CNAME target customers point their custom domains to.
MESSER_CNAME_TARGET=cname.messer.local
