# =============================================================================
# Messer — environment variables
# Copy to `.env` (git-ignored) and fill in. Every variable is optional for local
# development: when a key is missing, Messer uses a mock/sandbox adapter and the
# feature is listed under "Pending keys" in PROGRESS.md.
# =============================================================================

# --- Core -------------------------------------------------------------------
# local | staging | production
MESSER_ENV=local
# Public URL of the web app (Next.js). Used for links in emails, OAuth callbacks, widget.
MESSER_WEB_URL=http://localhost:3000
# Public URL of the platform API (FastAPI). The web app proxies /api/* to it.
MESSER_API_URL=http://localhost:8000
# Internal URL of the runtime (data plane). Control plane -> data plane calls.
MESSER_RUNTIME_URL=http://localhost:8100
# Web: directory that contains the repository's docs/ and legal/ folders (public docs and legal pages).
# Defaults to the repository root (two levels above apps/web); set it if a container copies them elsewhere.
MESSER_CONTENT_ROOT=
# Internal URL of the voice gateway.
MESSER_VOICE_URL=http://localhost:8300
# 32-byte urlsafe base64 master key used to encrypt secrets/credentials at rest (Fernet).
# Generate with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MESSER_SECRETS_KEY=
# HMAC secret for session JWTs in local auth mode and for signed single-use links.
MESSER_JWT_SECRET=
# Shared token that authenticates control plane <-> data plane calls (mTLS-ready, see docs/byoc.md).
MESSER_SERVICE_TOKEN=
# Optional mTLS material for control plane <-> data plane (paths to PEM files).
MESSER_MTLS_CA=
MESSER_MTLS_CERT=
MESSER_MTLS_KEY=
# Where project git repositories live (one repo per project).
MESSER_PROJECTS_DIR=./.data/projects
# Local file storage root used when Supabase Storage is not configured.
MESSER_STORAGE_DIR=./.data/storage
# First superadmin created by `make bootstrap`.
MESSER_SUPERADMIN_EMAIL=admin@messer.local
MESSER_SUPERADMIN_PASSWORD=
# Margin applied on top of raw model cost when converting to credits (0.3 = +30%).
MESSER_CREDIT_MARGIN=0.3
# USD value of one credit.
MESSER_CREDIT_USD=0.01

# --- Database (Supabase Postgres, EU region) --------------------------------
# Owner connection used for migrations (Alembic) and bootstrap.
DATABASE_URL=postgresql+psycopg://messer:messer@localhost:5432/messer
# Application connection (role WITHOUT BYPASSRLS). Every request runs under RLS.
DATABASE_APP_URL=postgresql+psycopg://messer_app:messer_app@localhost:5432/messer
# Read-only connection for agent/console SQL (role messer_readonly).
DATABASE_READONLY_URL=postgresql+psycopg://messer_readonly:messer_readonly@localhost:5432/messer

# --- Supabase (Auth + Storage, EU region) -----------------------------------
# When empty, Messer uses its built-in local auth (email+password, JWT) and local file storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret of the Supabase project (Settings -> API) to verify access tokens.
SUPABASE_JWT_SECRET=

# --- Redis (queue, cache, real time; EU region) ------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Models -----------------------------------------------------------------
# Direct Anthropic API. Without it the model gateway serves a deterministic demo model.
ANTHROPIC_API_KEY=
# Claude on AWS Bedrock in an EU region (required for eu_strict organizations).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# Optional: other providers accepted by the router (provider/model strings).
OPENAI_API_KEY=
# Embeddings for new knowledge bases: local (fastembed, default) | hash (offline, deterministic) | voyage | bedrock.
# local uses intfloat/multilingual-e5-small (384 dims, downloaded once into MESSER_RUNTIME_CACHE_DIR); when the
# model cannot be loaded, new knowledge bases fall back to the offline hash-384 embedder. eu_strict organizations
# never use Voyage (local or Bedrock EU only).
MESSER_EMBEDDINGS_PROVIDER=local
# Optional explicit model id for new knowledge bases (e.g. voyage/voyage-3.5, bedrock/amazon.titan-embed-text-v2:0).
MESSER_EMBEDDINGS_MODEL=
MESSER_EMBEDDINGS_BATCH_SIZE=32
VOYAGE_API_KEY=
VOYAGE_EMBEDDINGS_MODEL=voyage-3.5
BEDROCK_EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
# Knowledge ingestion limits and parser (Docling is used when installed and enabled).
MESSER_KB_MAX_FILE_MB=100
MESSER_KB_MAX_FILES_PER_UPLOAD=20
MESSER_KB_DOCLING_ENABLED=true
# Read-only SQL console / agent SQL: statement timeout and maximum rows returned.
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_ROW_LIMIT=1000

# --- Stripe (test-mode keys are fine) ----------------------------------------
# When empty, billing runs in simulated test mode (no network calls): checkouts open a "Modo de prueba"
# page and confirming fires the same handlers as the Stripe webhooks.
# With a key: activate Stripe Tax (Settings → Tax) and the customer portal, then sync plans from
# /admin → Planes ("Sincronizar con Stripe"). Webhook endpoint: https://<api>/api/v1/webhooks/stripe with
# events checkout.session.completed, checkout.session.async_payment_succeeded, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid, invoice.payment_failed,
# invoice.finalized, invoice.updated, invoice.voided, invoice.marked_uncollectible. Its signing secret
# (whsec_...) goes in STRIPE_WEBHOOK_SECRET; without it the webhook endpoint answers 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Email (transactional provider with an EU region) -----------------------
# console | smtp | postmark | resend
MESSER_EMAIL_PROVIDER=smtp
MESSER_EMAIL_FROM="Messer <no-reply@messer.local>"
# Receives public contact-form submissions (website /contact). Falls back to MESSER_SUPERADMIN_EMAIL.
MESSER_SALES_EMAIL=
# Receives service-health alerts from the scheduler (service down / recovered). Falls back to MESSER_SUPERADMIN_EMAIL.
MESSER_OPS_EMAIL=
# SMTP (Mailpit locally: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
# Postmark (EU) / Resend (EU) tokens if you use them instead of SMTP.
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
# Processing region of the email provider (e.g. eu-west-1). Organizations in strict EU residency
# only use Resend/Postmark/SES when this is an EU region; SMTP relays and the console are always allowed.
MESSER_EMAIL_REGION=
# Domain for inbound email addresses (workflow triggers, email channel).
MESSER_INBOUND_EMAIL_DOMAIN=in.messer.local
# Shared secret the inbound email provider uses to sign webhook calls.
MESSER_INBOUND_EMAIL_SECRET=

# --- Observability ----------------------------------------------------------
# Sentry (EU region: https://<key>@<org>.ingest.de.sentry.io/<project>)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# PostHog (EU instance)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# OTLP endpoint for traces (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- OAuth apps (connectors and social login) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Connector OAuth callbacks: register https://<web>/api/v1/connections/oauth/<connector>/callback in each app
# (connectors: google_drive, gmail, google_calendar, onedrive, sharepoint, outlook, slack, notion, hubspot,
# salesforce). Without an app the connector runs in demo mode with sample data.
# GitHub project sync. With a GitHub App (recommended) set the four GITHUB_APP_* values and point the App's
# webhook to {MESSER_WEB_URL}/api/github/webhook (push events). Without them, admins can connect a repository with
# a fine-grained personal access token (stored encrypted).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key of the App (newlines as \n).
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# GitHub OAuth app (only for the GitHub connector).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Overrides for GitHub Enterprise Server (defaults: https://api.github.com and https://github.com).
MESSER_GITHUB_API_URL=
MESSER_GITHUB_GIT_URL=
# Prebuilt engine wheel bundled into project exports (otherwise built once with uv into the runtime cache).
MESSER_ENGINE_WHEEL=

# --- Connectors ---------------------------------------------------------------
# Allow HTTP/MCP/database connector targets on private networks (always allowed in local/test). In
# production keep it off: customers reach internal systems through the on-prem connector agent.
MESSER_CONNECTORS_ALLOW_PRIVATE_NETWORKS=false
# Allow MCP servers started by command (stdio) from the control plane (default: only in local/test).
MESSER_MCP_STDIO_ENABLED=
# Seconds the control plane waits for an on-prem connector agent to answer one request.
MESSER_CONNECTOR_AGENT_RPC_TIMEOUT_S=30
# Largest file a connector sync downloads into a knowledge base (MB).
MESSER_CONNECTORS_MAX_FILE_MB=100

# --- Channels and voice -----------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELNYX_API_KEY=
# Telnyx account public key (verifies Ed25519 webhook signatures) and the Call Control application id.
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# STT / TTS providers (EU regions). Without keys the voice module uses its local defaults.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Processing region of the hosted voice providers (e.g. ie1 for Twilio Dublin, eu for Deepgram EU).
# Strict EU residency organizations only use hosted voice providers with an EU region.
MESSER_VOICE_REGION=
# Public base URL of the voice service (reached by browsers and Twilio/Telnyx), e.g. https://voice.messer.eu.
# Empty → MESSER_VOICE_URL. The web edge adds its ws(s):// origin to the Content-Security-Policy.
MESSER_VOICE_PUBLIC_URL=
# Call behaviour: maximum call length, silence before a check-in, silence before hanging up (browser / phone),
# time allowed for one agent turn and delay before a filler phrase ("un momento…").
MESSER_VOICE_MAX_CALL_SECS=900
MESSER_VOICE_IDLE_SECS=10
MESSER_VOICE_IDLE_HANGUP_SECS=120
MESSER_VOICE_PHONE_IDLE_HANGUP_SECS=45
MESSER_VOICE_TURN_TIMEOUT_SECS=60
MESSER_VOICE_FILLER_DELAY_SECS=1
# End-of-turn detection for STT providers without native turn detection: lexical | local (downloads models).
MESSER_VOICE_TURN_DETECTOR=lexical
# Scratch directory for recordings before they are uploaded to storage.
MESSER_VOICE_RECORDING_DIR=./.data/voice-recordings
MESSER_VOICE_PORT=8300

# --- Enterprise: GDPR and retention ------------------------------------------
# Days a data export (zip) can be downloaded through its signed link before it is deleted.
MESSER_DATA_EXPORT_TTL_DAYS=7
# Rows deleted per transaction by the retention task (traces and conversations past each org's retention).
MESSER_RETENTION_BATCH_SIZE=1000

# --- Deployment --------------------------------------------------------------
# Root domain for published interfaces and custom domains (e.g. messer.eu)
MESSER_ROOT_DOMAIN=localhost
# CNAME target customers point their custom domains to.
MESSER_CNAME_TARGET=cname.messer.local
