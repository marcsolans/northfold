# ─────────────────────────────────────────────────────────────────────────────
# Northfold environment variables. Copy to `.env` and fill in.
# Validated at startup by src/env.ts — the app refuses to boot with a clear message
# if anything required is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Runtime connection. On Neon use the *pooled* URL (host contains "-pooler").
# Locally: postgresql://northfold:northfold@localhost:5432/northfold
DATABASE_URL="postgresql://northfold:northfold@localhost:5432/northfold?schema=public"
# Direct (non-pooled) connection used only by Prisma Migrate. On Neon use the URL
# without "-pooler". Locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://northfold:northfold@localhost:5432/northfold?schema=public"

# ── App URLs (required) ──────────────────────────────────────────────────────
# Public origin of the store; used for Stripe redirect URLs, sitemap and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Better Auth (required) ───────────────────────────────────────────────────
# Random secret, at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Origin Better Auth runs on (same as NEXT_PUBLIC_APP_URL).
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated emails promoted to ADMIN by `pnpm db:seed` (the users must have
# signed up first).
ADMIN_EMAILS=""

# ── Google OAuth (optional: enables "Continue with Google") ───────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe (optional: enables card payments) ─────────────────────────────────
# Dashboard → Developers → API keys. Use test keys (sk_test_...) outside production.
STRIPE_SECRET_KEY=""
# Webhook signing secret (whsec_...). Locally: `stripe listen --print-secret`.
# In production: Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=""

# ── Cloudinary (optional: enables admin image uploads) ───────────────────────
# Cloudinary Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
