# Copy to .env.local (local dev) or set in Vercel → Project → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys). Without it, /api/lead answers
# { fallback: "mailto" } and the forms open the visitor's mail app instead.
RESEND_API_KEY=

# Sender for lead emails. Must be on a domain verified in Resend, e.g. "Kofen <web@kofen.ai>".
# Defaults to Resend's test sender (onboarding@resend.dev), which only delivers to your own Resend account email.
RESEND_FROM=

# Inbox that receives leads. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
LEAD_TO=

# Public site URL (canonical links, sitemap, Open Graph). Default: https://kofen.ai
NEXT_PUBLIC_SITE_URL=

# Public contact address shown on the site and used for mailto links. Default: hello@kofen.ai
NEXT_PUBLIC_CONTACT_EMAIL=
